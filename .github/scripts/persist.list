# هر مسیر در یک خط — این مسیرها بین ریست‌ها ذخیره و بازیابی می‌شوند.
# برای افزودن مسیر جدید، فقط یک خط اضافه کنید (مثلاً /var/lib/mysql).
# خطوطی که با # شروع می‌شوند نادیده گرفته می‌شوند.

# خانهٔ کاربر و فایل‌های شخصی
/home/Hamid
/root

# تنظیمات سیستم
/etc

# برنامه‌ها و سرویس‌های نصب‌شده خارج از apt
/opt
/srv
/usr/local

# وب‌اپلیکیشن‌ها و cron jobs
/var/www
/var/spool/cron
