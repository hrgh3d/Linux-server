# ============================================================================
# persist.list (v5.1) — ریشه‌های «داده/تنظیمات کاربر» که اسکن و بکاپ می‌شوند.
#
# فقط Configuration و Data در این ریشه‌ها ذخیره می‌شود؛ فایل‌های نصبِ پکیج‌ها
# به‌صورت خودکار حذف می‌شوند (payload.py) چون پکیج‌ها در Restore با دستور
# نصب خودشان بازنصب می‌شوند (catalog در installed.json + provision.sh).
#
# نتیجه: هر فایل/کانفیگ جدیدی که یک پکیج در این ریشه‌ها بسازد — حتی در مسیر
# جدید یا با نام جدید یا بعداً — خودکار شناسایی و در زمان Restore بازیابی
# می‌شود. برای افزودن ریشهٔ جدید فقط کافی است مسیر را اینجا اضافه کنید.
# ============================================================================

# فایل‌های شخصی و محیط root/Hamid
/home/Hamid
/root

# هویت Tailscale (Node Key => حفظ IP ثابت)
/var/lib/tailscale

# کانفیگ‌های سیستمی کاربر (/etc) — فایل‌های گذرای میزبان/image فیلتر می‌شوند
/etc

# برنامه‌ها و ابزارهای افزوده‌شده توسط کاربر در مسیرهای محلی
# (فایل‌های ازپیش‌نصب image با نام از base_*.list حذف می‌شوند؛ فقط فایل‌های
#  جدیدِ کاربر ذخیره می‌شوند؛ پکیج‌های npm/hermes/x-ui جدا بازنصب می‌شوند)
# v4.5.3: اضافه شدن /usr/local/lib برای hermes-agent venv (پایداری gateway)
/usr/local/bin
/usr/local/sbin
/usr/local/lib

# وب‌سرورها، سرویس‌ها و زمان‌بندی
/opt
/srv
/var/www
/var/spool/cron

# داده‌های عمومی سرویس‌ها (دیتابیس و …) — دایرکتوری‌های سنگین image حذف می‌شوند
/var/lib
/var/opt
