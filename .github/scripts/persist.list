# ============================================================================
# persist.list — مسیرهایی که بین چرخه‌های سرور ذخیره و بازیابی می‌شوند.
# ============================================================================

# فایل‌های شخصی و دایرکتوری‌های Home
/home/Hamid
/root

# هویت و وضعیت پایدار Tailscale (جهت حفظ ثابت IP و Hostname در Tailnet)
/var/lib/tailscale

# تنظیمات و کانفیگ‌های سیستم (با فیلتر خودکار فایل‌های گذرای میزبان)
/etc

# برنامه‌ها و پکیج‌های نصب‌شده در مسیرهای استاندارد غیراصلی
/opt
/srv
/usr/local

# وب‌سرورها، سرویس‌ها و زمان‌بندی‌های Cron
/var/www
/var/spool/cron
