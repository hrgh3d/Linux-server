# ============================================================================
# persist.list — مسیرهایی که بین چرخه‌های سرور (v4) ذخیره و بازیابی می‌شوند.
#
# نکته: /etc به‌صورت کامل با فیلتر فایل‌های گذرای میزبان ذخیره می‌شود؛
#       کلیدهای Host سرور (etc/ssh/ssh_host_*) به‌صورت جداگانه تضمین می‌شوند.
# ============================================================================

# فایل‌های شخصی و دایرکتوری‌های Home
/home/Hamid
/root

# هویت و وضعیت پایدار Tailscale (حفظ Node Key => حفظ IP و Hostname در Tailnet)
/var/lib/tailscale

# تنظیمات و کانفیگ‌های سیستم (فیلتر فایل‌های گذرا در save.sh/restore.sh)
/etc

# برنامه‌ها و اسکریپت‌های نصب‌شده در مسیرهای محلی
/usr/local/bin
/usr/local/sbin
/opt
/srv

# پکیج‌های سراسری نصب‌شده با npm (کد واقعی؛ bin ها symlink در /usr/local/bin هستند)
/usr/local/lib/node_modules

# Hermes Agent (Nous Research) — کد و uv-python نصب‌شده برای root (FHS layout)
# دیتای آن در /root/.hermes است که همراه /root خودکار ذخیره می‌شود.
/usr/local/lib/hermes-agent
/usr/local/share/uv

# 3x-ui — باینری/پنل (دیتابیس و تنظیمات در /etc/x-ui است که همراه /etc ذخیره می‌شود)
/usr/local/x-ui

# وب‌سرورها، سرویس‌ها و زمان‌بندی‌های Cron
/var/www
/var/spool/cron
