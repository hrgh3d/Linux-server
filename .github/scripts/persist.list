# ============================================================================
# persist.list (v5.3) — ریشه‌های «داده/تنظیمات کاربر» که اسکن و بکاپ می‌شوند.
# v5.3: اضافه شدن /usr/local/share/uv چون hermes venv به آن symlink است
#       (venv/bin/python -> /usr/local/share/uv/python/.../bin/python3.11)
#       بدون آن، hermes با خطای No such file or directory مواجه می‌شود
# ============================================================================

# فایل‌های شخصی و محیط root/Hamid
/home/Hamid
/root

# هویت Tailscale (Node Key => حفظ IP ثابت)
/var/lib/tailscale

# کانفیگ‌های سیستمی کاربر (/etc) — فایل‌های گذرای میزبان/image فیلتر می‌شوند
/etc

# برنامه‌ها و ابزارهای افزوده‌شده توسط کاربر در مسیرهای محلی
# v5.3: hermes-agent + uv python (وابستگی venv)
/usr/local/bin
/usr/local/sbin
/usr/local/lib/hermes-agent
/usr/local/share/uv

# وب‌سرورها، سرویس‌ها و زمان‌بندی
/opt
/srv
/var/www
/var/spool/cron

# داده‌های عمومی سرویس‌ها (دیتابیس و …)
/var/lib
/var/opt
